########################################
# AWS REGION AND ENVIRONMENT
########################################
region       = "us-east-1"
environment  = "prod"
project_name = "enterprise-3tier"
owner        = "platform-team"

########################################
# NETWORK CONFIGURATION
########################################
vpc_cidr                 = "10.20.0.0/16"
public_subnet_cidrs      = ["10.20.0.0/24", "10.20.1.0/24"]
private_app_subnet_cidrs = ["10.20.10.0/24", "10.20.11.0/24"]
private_db_subnet_cidrs  = ["10.20.20.0/24", "10.20.21.0/24"]

########################################
# APPLICATION TIER CONFIGURATION
########################################
instance_type      = "t3.small"
desired_capacity   = 2
min_capacity       = 2
max_capacity       = 4
ssh_allowed_cidr   = "203.0.113.0/24"
key_name           = null

########################################
# STORAGE AND MONITORING
########################################
root_volume_size   = 30
app_port           = 3000

########################################
# DOMAIN AND SSL CONFIGURATION
########################################
domain_name       = "example.com"
subdomain         = "app"
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

########################################
# ALB SECURITY AND LOGGING
########################################
enable_deletion_protection = true
enable_alb_access_logs     = false
alb_access_logs_bucket_name = null

########################################
# TERRAFORM STATE BACKEND
########################################
tf_state_bucket_name = "enterprise-3tier-tfstate"
tf_lock_table_name   = "enterprise-3tier-tf-locks"

########################################
# CI/CD AND GITHUB CONFIGURATION
########################################
codestar_connection_arn = "arn:aws:codestar-connections:us-east-1:123456789012:connection/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
github_owner            = "your-org"
github_repo             = "your-repo"
github_branch           = "main"

########################################
# MONITORING AND ALERTING
########################################
monitoring_alarm_actions = []
